#version 450 core
// ============================================================================
//  Hi-Z Depth Bounds — conservative min/max mip reduction
//
//  Each parent texel must conservatively contain every valid child interval:
//
//      parent.nearest  = min(child.nearest)  over valid children
//      parent.farthest = max(child.farthest) over valid children
//
//  Empty children (nearest > farthest) are ignored. If every child is empty
//  the parent is empty too.
//
//  Odd mip dimensions: the 2x2 footprint is clamped to the source size, so the
//  last row/column re-reads its edge texel. Re-reading a child is harmless for
//  a min/max reduction because it cannot change the result.
// ============================================================================

#include "shaders/common/hiz_bounds.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D u_SourceTexture;
uniform int u_SrcLevel;

layout(rg32f, binding = 0) uniform writeonly image2D u_DestMip;

void main() {
    ivec2 dstPos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(u_DestMip);

    if (dstPos.x >= dstSize.x || dstPos.y >= dstSize.y) {
        return;
    }

    ivec2 srcSize = textureSize(u_SourceTexture, u_SrcLevel);
    ivec2 baseSrc = dstPos * 2;

    ivec2 p0 = min(baseSrc + ivec2(0, 0), srcSize - 1);
    ivec2 p1 = min(baseSrc + ivec2(1, 0), srcSize - 1);
    ivec2 p2 = min(baseSrc + ivec2(0, 1), srcSize - 1);
    ivec2 p3 = min(baseSrc + ivec2(1, 1), srcSize - 1);

    vec2 c0 = texelFetch(u_SourceTexture, p0, u_SrcLevel).rg;
    vec2 c1 = texelFetch(u_SourceTexture, p1, u_SrcLevel).rg;
    vec2 c2 = texelFetch(u_SourceTexture, p2, u_SrcLevel).rg;
    vec2 c3 = texelFetch(u_SourceTexture, p3, u_SrcLevel).rg;

    // Start from the empty pair so min()/max() naturally skip empty children.
    float nearest = HIZ_EMPTY_NEAREST;
    float farthest = HIZ_EMPTY_FARTHEST;

    // A child is valid when nearest <= farthest. The comparison is written so
    // NaN children are rejected as well.
    if (c0.x <= c0.y) { nearest = min(nearest, c0.x); farthest = max(farthest, c0.y); }
    if (c1.x <= c1.y) { nearest = min(nearest, c1.x); farthest = max(farthest, c1.y); }
    if (c2.x <= c2.y) { nearest = min(nearest, c2.x); farthest = max(farthest, c2.y); }
    if (c3.x <= c3.y) { nearest = min(nearest, c3.x); farthest = max(farthest, c3.y); }

    imageStore(u_DestMip, dstPos, vec4(nearest, farthest, 0.0, 0.0));
}
