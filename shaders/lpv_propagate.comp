#version 430

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(rgba16f, binding = 0) uniform readonly image3D u_LPV_Input;
layout(rgba16f, binding = 1) uniform writeonly image3D u_LPV_Output;

struct PointLightData {
    vec4 pos_radius;      // xyz = position, w = radius
    vec4 color_intensity; // rgb = color, w = intensity
};

layout (std430, binding = 3) buffer PointLightBuffer {
    PointLightData u_PointLights[];
};

uniform int u_PointLightCount = 0;
uniform vec3 u_LPV_Min = vec3(-32.0, -2.0, -32.0);
uniform vec3 u_LPV_Size = vec3(64.0, 32.0, 64.0);
uniform vec4 u_SunDirection_Intensity = vec4(0.35, -0.85, 0.40, 4.0);
uniform vec4 u_SunColor_Ambient = vec4(1.0, 0.95, 0.8, 0.04);
uniform float u_LPV_PropagationFactor = 0.50;
uniform float u_LPV_Intensity = 1.0;

const ivec3 NEIGHBORS[6] = ivec3[](
    ivec3( 1,  0,  0),
    ivec3(-1,  0,  0),
    ivec3( 0,  1,  0),
    ivec3( 0, -1,  0),
    ivec3( 0,  0,  1),
    ivec3( 0,  0, -1)
);

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID);
    if (pos.x >= 32 || pos.y >= 32 || pos.z >= 32) return;

    vec3 voxel_norm = (vec3(pos) + 0.5) / 32.0;
    vec3 world_pos = u_LPV_Min + voxel_norm * u_LPV_Size;

    // 1. Dynamic Local Point Lights Volumetric Injection (physically balanced)
    vec3 point_lights_rad = vec3(0.0);
    int active_lights = clamp(u_PointLightCount, 0, 256);
    for (int i = 0; i < active_lights; ++i) {
        vec3 pl_pos = u_PointLights[i].pos_radius.xyz;
        float pl_radius = u_PointLights[i].pos_radius.w;
        vec3 pl_color = u_PointLights[i].color_intensity.rgb;
        float pl_intensity = u_PointLights[i].color_intensity.w;

        float dist = length(world_pos - pl_pos);
        if (dist < pl_radius) {
            float norm_dist = dist / pl_radius;
            float window = clamp(1.0 - norm_dist * norm_dist, 0.0, 1.0);
            float atten = (window * window) / (1.0 + dist * dist);
            point_lights_rad += pl_color * (pl_intensity * atten * 0.08);
        }
    }

    // 2. Sunlight Ground Bounce:
    // Sunlight hitting the ground plane creates warm upward indirect bounce
    float height_above_ground = max(world_pos.y, 0.0);
    float ground_falloff = exp(-height_above_ground * 0.25);
    vec3 floor_bounce = u_SunColor_Ambient.rgb * (u_SunDirection_Intensity.w * 0.015) * ground_falloff;

    // 3. Sky Diffuse Ambient scattered into the volume
    float sky_exp = clamp(voxel_norm.y, 0.0, 1.0);
    vec3 sky_indirect = mix(vec3(0.01, 0.015, 0.02), vec3(0.025, 0.035, 0.05), sky_exp) * 0.02;

    // 4. Gather 6-Neighbor Propagated Radiance
    vec4 neighbor_rad = vec4(0.0);
    for (int i = 0; i < 6; ++i) {
        ivec3 n_pos = clamp(pos + NEIGHBORS[i], ivec3(0), ivec3(31));
        neighbor_rad += imageLoad(u_LPV_Input, n_pos);
    }
    neighbor_rad /= 6.0;

    // Direct injection + energy-conserving neighbor propagation
    vec3 direct_injection = floor_bounce + sky_indirect + point_lights_rad;
    vec3 propagated_color = neighbor_rad.rgb * u_LPV_PropagationFactor + direct_injection;
    propagated_color *= u_LPV_Intensity;

    // Temporal smoothing to prevent flicker
    vec3 prev_val = imageLoad(u_LPV_Input, pos).rgb;
    vec3 final_color = mix(propagated_color, prev_val, 0.35);

    imageStore(u_LPV_Output, pos, vec4(final_color, 1.0));
}
