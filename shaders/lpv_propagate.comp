#version 430

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(rgba16f, binding = 0) uniform readonly image3D u_LPV_Input;
layout(rgba16f, binding = 1) uniform writeonly image3D u_LPV_Output;

uniform vec3 u_LPV_Min = vec3(-32.0, -2.0, -32.0);
uniform vec3 u_LPV_Size = vec3(64.0, 32.0, 64.0);
uniform vec4 u_SunDirection_Intensity = vec4(0.35, -0.85, 0.40, 4.0);
uniform vec4 u_SunColor_Ambient = vec4(1.0, 0.95, 0.8, 0.04);
uniform float u_LPV_PropagationFactor = 0.82;
uniform float u_LPV_Intensity = 1.0;

const ivec3 NEIGHBORS[6] = ivec3[](
    ivec3( 1,  0,  0),
    ivec3(-1,  0,  0),
    ivec3( 0,  1,  0),
    ivec3( 0, -1,  0),
    ivec3( 0,  0,  1),
    ivec3( 0,  0, -1)
);

void main() {
    ivec3 pos = ivec3(gl_GlobalInvocationID);
    if (pos.x >= 32 || pos.y >= 32 || pos.z >= 32) return;

    vec3 voxel_norm = (vec3(pos) + 0.5) / 32.0;
    vec3 world_pos = u_LPV_Min + voxel_norm * u_LPV_Size;

    // Direct injection into volume:
    // Sunlight hitting the ground (near y=0) creates upward indirect bounce
    float height_above_ground = clamp(world_pos.y, 0.0, 20.0);
    float ground_bounce_falloff = exp(-height_above_ground * 0.15);

    // Warm ground bounce color (sunlight reflected off terrain/floor)
    vec3 floor_bounce = u_SunColor_Ambient.rgb * (u_SunDirection_Intensity.w * 0.18) * ground_bounce_falloff;

    // Sky diffuse ambient scattered into the volume
    float sky_exposure = clamp(voxel_norm.y, 0.0, 1.0);
    vec3 sky_indirect = mix(vec3(0.08, 0.10, 0.12), vec3(0.18, 0.25, 0.35), sky_exposure) * 0.25;

    // Gather neighbor propagated radiance
    vec4 neighbor_rad = vec4(0.0);
    for (int i = 0; i < 6; ++i) {
        ivec3 n_pos = clamp(pos + NEIGHBORS[i], ivec3(0), ivec3(31));
        neighbor_rad += imageLoad(u_LPV_Input, n_pos);
    }
    neighbor_rad /= 6.0;

    // Combine injection + propagation
    vec3 propagated_color = neighbor_rad.rgb * u_LPV_PropagationFactor + floor_bounce + sky_indirect;
    propagated_color *= u_LPV_Intensity;

    imageStore(u_LPV_Output, pos, vec4(propagated_color, 1.0));
}
