#version 430 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) writeonly uniform image2D u_OutputMerged;
layout(binding = 1) uniform sampler2D u_RawRadiance;
layout(binding = 2) uniform sampler2D u_GBufferDepth;
layout(binding = 3) uniform sampler2D u_GBufferNormalMetallic;
layout(binding = 4) uniform sampler2D u_HistoryRadiance;
layout(binding = 5) uniform sampler2D u_MotionVectors;

layout(std140, binding = 0) uniform FrameData {
    mat4 u_View;
    mat4 u_Projection;
    mat4 u_ViewProjection;
    mat4 u_InvProjection;
    mat4 u_InvView;
    vec4 u_CameraPos_Time;
    vec4 u_ScreenSize_Jitter;
    vec4 u_SunDirection_Intensity;
    vec4 u_SunColor_Ambient;
    mat4 u_LightViewProjection[4];
    vec4 u_CascadeSplits;
    vec4 u_FogColor_Density;
    vec4 u_FogParams;
};

uniform vec2 u_TargetResolution;
uniform float u_TemporalBlend;
uniform int u_HistoryValid;

vec3 ViewPosition(vec2 uv, float depth) {
    vec4 p = u_InvProjection * vec4(uv * 2.0 - 1.0, depth, 1.0);
    return p.xyz / max(abs(p.w), 1e-6);
}

vec3 OctahedralDecode(vec2 f) {
    f = f * 2.0 - 1.0;
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    return normalize(n);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_OutputMerged);
    if (pixel.x >= outputSize.x || pixel.y >= outputSize.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / u_TargetResolution;
    float depth = texture(u_GBufferDepth, uv).r;
    if (depth <= 1e-6) {
        imageStore(u_OutputMerged, pixel, vec4(0.0));
        return;
    }

    vec3 centerPosition = ViewPosition(uv, depth);
    vec3 centerNormal = normalize(mat3(u_View) * OctahedralDecode(texture(u_GBufferNormalMetallic, uv).rg));
    vec2 texel = 1.0 / u_TargetResolution;
    vec3 spatialRadiance = vec3(0.0);
    float spatialWeight = 0.0;
    float depthSigma = max(0.08, abs(centerPosition.z) * 0.012);
    const float kernel[9] = float[](1.0, 8.0, 28.0, 56.0, 70.0, 56.0, 28.0, 8.0, 1.0);

    vec3 neighborhoodMin = vec3(1e20);
    vec3 neighborhoodMax = vec3(0.0);
    for (int y = -4; y <= 4; ++y) {
        for (int x = -4; x <= 4; ++x) {
            vec2 sampleUV = uv + vec2(x, y) * texel;
            if (any(lessThan(sampleUV, vec2(0.0))) || any(greaterThan(sampleUV, vec2(1.0)))) {
                continue;
            }

            float sampleDepth = texture(u_GBufferDepth, sampleUV).r;
            if (sampleDepth <= 1e-6) {
                continue;
            }
            vec3 samplePosition = ViewPosition(sampleUV, sampleDepth);
            vec3 sampleNormal = normalize(mat3(u_View) * OctahedralDecode(texture(u_GBufferNormalMetallic, sampleUV).rg));
            float planeDistance = abs(dot(centerNormal, samplePosition - centerPosition));
            float normalWeight = pow(max(dot(centerNormal, sampleNormal), 0.0), 24.0);
            float spatialKernel = kernel[x + 4] * kernel[y + 4];
            float weight = spatialKernel * exp(-planeDistance / depthSigma) * normalWeight;
            vec3 sampleRadiance = texture(u_RawRadiance, sampleUV).rgb;
            spatialRadiance += sampleRadiance * weight;
            spatialWeight += weight;
            neighborhoodMin = min(neighborhoodMin, sampleRadiance);
            neighborhoodMax = max(neighborhoodMax, sampleRadiance);
        }
    }
    vec3 current = spatialRadiance / max(spatialWeight, 1e-5);

    float temporalWeight = 0.0;
    vec2 motion = texture(u_MotionVectors, uv).rg;
    vec2 previousUV = uv - motion;
    if (u_HistoryValid != 0 &&
        all(greaterThanEqual(previousUV, vec2(0.0))) &&
        all(lessThanEqual(previousUV, vec2(1.0)))) {
        vec4 history = texture(u_HistoryRadiance, previousUV);
        float historyDepthError = abs(history.a - abs(centerPosition.z));
        float historyDepthTolerance = max(0.10, abs(centerPosition.z) * 0.05);
        vec3 previous = history.rgb;
        vec3 historyClampMargin = max((neighborhoodMax - neighborhoodMin) * 0.75, vec3(0.05));
        previous = clamp(previous, neighborhoodMin - historyClampMargin, neighborhoodMax + historyClampMargin);
        temporalWeight = clamp(u_TemporalBlend, 0.0, 0.98)
                       * (1.0 - smoothstep(historyDepthTolerance, historyDepthTolerance * 2.0, historyDepthError));
        current = mix(current, previous, temporalWeight);
    }

    if (any(isnan(current)) || any(isinf(current))) {
        current = vec3(0.0);
    }
    imageStore(u_OutputMerged, pixel, vec4(clamp(current, vec3(0.0), vec3(30.0)), abs(centerPosition.z)));
}
