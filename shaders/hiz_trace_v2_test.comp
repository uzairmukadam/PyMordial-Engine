#version 450 core
// ============================================================================
//  TraceHiZ V2.3 test harness (isolated; not used by production passes)
//
//  Ray data is supplied via an SSBO. Each invocation traces one ray and writes:
//      row 0: hit(0/1), hitUV.x, hitUV.y, rayDistance
//      row 1: linearDepth, iterations, missReason, setupValid(0/1)
//  Optional cell trace (binding 1) records visited (cellX, cellY, mip, valid).
// ============================================================================

#include "shaders/common/hiz_trace_v2.glsl"

layout(local_size_x = 1, local_size_y = 1) in;

layout(binding = 0) uniform sampler2D u_DepthTexture;
layout(binding = 1) uniform sampler2D u_HizBounds;
layout(rgba32f, binding = 0) uniform writeonly image2D u_Output;  // 3 rows per ray
layout(rgba32f, binding = 1) uniform writeonly image2D u_CellTrace;

layout(std430, binding = 0) readonly buffer RayBuffer {
    // 8 floats per ray: origin.xyz, dir.xyz, tStart, tEnd
    float u_Rays[];
};

uniform mat4 u_Projection;
uniform mat4 u_InvProjection;
uniform int u_RayCount;
uniform float u_Thickness;
uniform int u_MaxIterations;
uniform int u_StartMip;
uniform int u_Hierarchical;   // 0 = mip-0 only, 1 = descent-only, 2 = descent+ascent
uniform int u_TraceCells;

void main() {
    int idx = int(gl_GlobalInvocationID.x);
    if (idx >= u_RayCount) {
        return;
    }

    int base = idx * 8;
    vec3 origin = vec3(u_Rays[base + 0], u_Rays[base + 1], u_Rays[base + 2]);
    vec3 direction = vec3(u_Rays[base + 3], u_Rays[base + 4], u_Rays[base + 5]);
    float tStart = u_Rays[base + 6];
    float tEnd = u_Rays[base + 7];

    HiZRayV2 ray = SetupHiZRayV2(origin, direction, tStart, tEnd, u_Projection);

    HiZTraceV2Result r;
    HiZTraceV2Diag diag;
    diag.startMip = u_StartMip; diag.finalMip = u_StartMip; diag.highestMip = u_StartMip;
    diag.ascents = 0; diag.descents = 0; diag.parentLookaheads = 0; diag.parentLookaheadSuccess = 0;
    if (u_Hierarchical == 2) {
        r = TraceHiZ2HierarchicalAscent(u_HizBounds, u_DepthTexture, ray, u_StartMip, u_Thickness, u_MaxIterations, u_InvProjection, diag);
    } else if (u_Hierarchical == 1) {
        r = TraceHiZ2Hierarchical(u_HizBounds, u_DepthTexture, ray, u_StartMip, u_Thickness, u_MaxIterations, u_InvProjection);
    } else {
        r = TraceHiZ2Mip0(u_DepthTexture, ray, u_Thickness, u_MaxIterations, u_InvProjection);
    }

    imageStore(u_Output, ivec2(idx, 0), vec4(r.hit ? 1.0 : 0.0, r.uv.x, r.uv.y, r.rayDistance));
    imageStore(u_Output, ivec2(idx, 1), vec4(r.linearDepth, float(r.iterations), float(r.missReason), ray.valid ? 1.0 : 0.0));
    imageStore(u_Output, ivec2(idx, 2), vec4(float(diag.startMip), float(diag.finalMip), float(diag.highestMip), float(diag.ascents)));
    imageStore(u_Output, ivec2(idx, 3), vec4(float(diag.descents), float(diag.parentLookaheads), float(diag.parentLookaheadSuccess), 0.0));

    if (u_TraceCells != 0 && ray.valid) {
        // Record the mip-0 cell sequence using the shared helpers.
        vec2 cellSizeUV = 1.0 / vec2(textureSize(u_DepthTexture, 0));
        float s = 0.0;
        int budget = max(u_MaxIterations, 1);
        for (int i = 0; i < budget; ++i) {
            if (s >= ray.screenLength) break;
            vec2 uv; float tE, wE;
            EvalHiZRayV2(ray, s, uv, tE, wE);
            if (HiZLeftScreenV2(ray, uv)) break;
            vec2 cc; float sExit;
            HiZCellExitV2(ray, s, cellSizeUV, cc, sExit);
            imageStore(u_CellTrace, ivec2(idx, i), vec4(cc.x, cc.y, float(i), 1.0));
            s = sExit;
        }
    }
}
