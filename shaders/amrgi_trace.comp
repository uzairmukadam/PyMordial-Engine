#version 430 core
// ============================================================================
//  Adaptive Multi-Range Global Illumination (AMRGI) — Trace Stage
//
//  One frame-rotated cosine-weighted hemisphere ray per active half-resolution
//  sample. The SAME ray is continued continuously through near -> mid -> far
//  ranges; it is never restarted at a range boundary.
//
//  Outputs:
//    u_OutputRadiance (RGBA16F): rgb = incoming indirect diffuse radiance,
//                                a   = confidence (0..1)
//    u_OutputAux      (RGBA16F): r = accepted hit distance (0 on miss),
//                                g = accepted range class (0 miss,1 near,2 mid,3 far),
//                                b = confidence,
//                                a = consecutive-miss streak (0..1)
//
//  Sample state is encoded in the aux alpha channel so the reconstruct stage can
//  distinguish a measured miss from "no information this frame":
//    a < 0.5   -> VALID_CURRENT_HIT (a = miss streak, always 0 on a hit)
//    a >= 0.5  -> EVALUATED_MISS    (a = 0.5 + 0.5 * missStreak)
//  A miss is a real measurement (the ray was traced and found nothing), so it is
//  NOT the same as a pixel that was never scheduled. The reconstruct stage uses
//  this to avoid decaying stable history toward black on isolated misses.
//
//  Adaptation is per-pixel and reads only the previous frame's aux texture
//  (no GPU->CPU readback). It never classifies the whole scene indoor/outdoor.
// ============================================================================

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) writeonly uniform image2D u_OutputRadiance;
layout(rgba16f, binding = 1) writeonly uniform image2D u_OutputAux;

layout(binding = 1) uniform sampler2D u_GBufferDepth;
layout(binding = 2) uniform sampler2D u_GBufferNormalMetallic;
layout(binding = 3) uniform sampler2D u_GBufferAlbedoRoughness;
layout(binding = 4) uniform sampler2D u_GBufferSurfaceID;
layout(binding = 5) uniform sampler2D u_DirectRadiance;
layout(binding = 6) uniform sampler2D u_PrevAux;

layout(std140, binding = 0) uniform FrameData {
    mat4 u_View;
    mat4 u_Projection;
    mat4 u_ViewProjection;
    mat4 u_InvProjection;
    mat4 u_InvView;
    vec4 u_CameraPos_Time;
    vec4 u_ScreenSize_Jitter;
    vec4 u_SunDirection_Intensity;
    vec4 u_SunColor_Ambient;
    mat4 u_LightViewProjection[4];
    vec4 u_CascadeSplits;
    vec4 u_FogColor_Density;
    vec4 u_FogParams;
};

#include "shaders/common/depth.glsl"
#include "shaders/common/pbr_brdf.glsl"
#include "shaders/common/ssrt/ssrt_common.glsl"
#include "shaders/common/ssrt/ssrt_trace.glsl"

uniform vec2 u_TargetResolution;   // half-resolution trace domain
uniform float u_NearEnd;           // ~3 m
uniform float u_MidEnd;            // ~12 m
uniform float u_FarEnd;            // ~40 m
uniform int u_NearSteps;           // dense
uniform int u_MidSteps;            // expanding
uniform int u_FarSteps;            // coarse
uniform int u_RefineIters;         // near-hit refinement iterations
uniform float u_Thickness;         // base thickness (m)
uniform float u_Intensity;
uniform int u_RayCount;            // rays per active sample (1..32)
uniform float u_RadianceClamp;     // stabilization clamp on hit radiance
uniform int u_HistoryValid;        // 0 on first frame / after reset
uniform int u_MidRate;             // 1 in N pixels trace mid when not requested
uniform int u_FarRate;             // 1 in N pixels trace far when not requested

// PI comes from common/pbr_brdf.glsl (macro). Its literal rounds to the same
// float32 value as the previous local constant, so behaviour is unchanged.
const float GOLDEN_RATIO = 1.61803398875;

// One cosine-weighted hemisphere direction. `u1` and `u2` must be independent
// low-discrepancy values; deriving both from one scalar collapses the samples
// onto a 1D spiral and leaves directional gaps that miss bounce paths.
// (Diffuse ray generation is GI-specific and intentionally stays here.)
vec3 CosineHemisphereRay(vec3 n, float u1, float u2) {
    float phi = 2.0 * PI * fract(u1);
    float cosTheta = sqrt(fract(u2));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    vec3 tangent, bitangent;
    SSRT_BuildBasis(n, tangent, bitangent);
    return normalize(tangent * (cos(phi) * sinTheta) + bitangent * (sin(phi) * sinTheta) + n * cosTheta);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(u_OutputRadiance);
    if (pixel.x >= outSize.x || pixel.y >= outSize.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / u_TargetResolution;
    float depth = texture(u_GBufferDepth, uv).r;
    if (IsBackgroundDepth(depth)) {
        imageStore(u_OutputRadiance, pixel, vec4(0.0));
        imageStore(u_OutputAux, pixel, vec4(0.0));
        return;
    }

    vec3 origin = ReconstructViewPosition(uv, depth, u_InvProjection);
    vec3 normalView = normalize(mat3(u_View) * OctahedralDecode(texture(u_GBufferNormalMetallic, uv).rg));
    float originSurfaceID = texture(u_GBufferSurfaceID, uv).r;
    origin += normalView * max(0.025, abs(origin.z) * 0.0005);

    // ---- Per-pixel adaptation from previous frame's aux (no readback) ----
    vec4 prevAux = u_HistoryValid != 0 ? texture(u_PrevAux, uv) : vec4(0.0);
    int prevClass = int(prevAux.g + 0.5);
    float prevConf = prevAux.b;
    // Decode miss streak from the state-encoded alpha (>=0.5 means last frame missed).
    float missStreak = prevAux.a >= 0.5 ? (prevAux.a - 0.5) * 2.0 : 0.0;

    float frameIndex = floor(u_CameraPos_Time.w * 30.0);
    uint frameU = uint(frameIndex);
    // Decorrelated per-pixel seeds. The previous implementation derived both
    // hemisphere angles from one smooth gradient hash, which produced a visible
    // checkerboard (corr(rot,rot2) = -0.41, spatial autocorr lag1 = -0.5). Each
    // dimension now comes from an independent integer hash of (pixel, frame).
    float rot  = SSRT_Hash01(uvec3(uint(pixel.x), uint(pixel.y), frameU * 2u + 0u));
    float rot2 = SSRT_Hash01(uvec3(uint(pixel.x), uint(pixel.y), frameU * 2u + 1u));
    // Per-pixel jitter for the march step offset (decorrelated from the angles).
    float noise = SSRT_Hash01(uvec3(uint(pixel.x) + 7919u, uint(pixel.y) + 104729u, frameU));

    // Sparse rotating schedule: hash(pixel, frame) selects mid/far refresh.
    float h = SSRT_InterleavedGradientNoise(vec2(pixel) * 1.7 + vec2(frameIndex * 13.0, frameIndex * 7.0));
    bool midScheduled = (int(mod(float(pixel.x + pixel.y * 3 + int(frameIndex)), float(max(u_MidRate, 1)))) == 0);
    bool farScheduled = (int(mod(float(pixel.x * 5 + pixel.y * 7 + int(frameIndex)), float(max(u_FarRate, 1)))) == 0);

    // Hysteresis: stable near hit reduces mid/far frequency; repeated miss
    // temporarily increases mid/far opportunity; stable far keeps sparse refresh.
    bool wantMid = midScheduled || prevClass <= 1 || missStreak > 0.5;
    bool wantFar = farScheduled || prevClass == 3 || missStreak > 0.75;

    vec3 dir = CosineHemisphereRay(normalView, rot, rot2);

    // ---- Multi-ray accumulation (distinct low-discrepancy directions) ----
    int rayCount = clamp(u_RayCount, 1, 32);
    vec3 radiance = vec3(0.0);
    float confidence = 0.0;
    float hitDist = 0.0;
    int rangeClass = 0;
    float nearestHit = 1e20;
    int hits = 0;

    for (int r = 0; r < rayCount; ++r) {
        // Distinct direction per ray: offset both low-discrepancy values.
        float rayRot = fract(rot + float(r) * 0.61803398875);
        float rayRot2 = fract(rot2 + float(r) * 0.38196601125);
        vec3 rdir = (r == 0) ? dir : CosineHemisphereRay(normalView, rayRot, rayRot2);

        SSRT_Hit hit = SSRT_TraceLinear(origin, rdir, uv, noise, 0.0, u_NearEnd, u_NearSteps, 1,
                             originSurfaceID, normalView, true, u_RefineIters, u_Thickness);
        if (!hit.hit && wantMid) {
            hit = SSRT_TraceLinear(origin, rdir, uv, noise, u_NearEnd, u_MidEnd, u_MidSteps, 2,
                             originSurfaceID, normalView, false, u_RefineIters, u_Thickness);
        }
        if (!hit.hit && wantFar) {
            hit = SSRT_TraceLinear(origin, rdir, uv, noise, u_MidEnd, u_FarEnd, u_FarSteps, 3,
                             originSurfaceID, normalView, false, u_RefineIters, u_Thickness);
        }

        if (hit.hit) {
            vec3 L = texture(u_DirectRadiance, hit.uv).rgb;
            if (any(isnan(L)) || any(isinf(L))) L = vec3(0.0);

            vec2 edge = smoothstep(vec2(0.0), vec2(0.06), hit.uv) * (1.0 - smoothstep(vec2(0.94), vec2(1.0), hit.uv));
            float edgeConf = edge.x * edge.y;
            float distConf = clamp(1.0 - hit.distance / max(u_FarEnd, 1e-3), 0.0, 1.0);

            // Firefly control: hue-preserving soft knee that is IDENTITY below the
            // threshold. Only genuine outliers (lum > u_RadianceClamp) are scaled
            // down; ordinary bright surfaces keep their full physical radiance.
            float lum = dot(L, vec3(0.2126, 0.7152, 0.0722));
            if (lum > u_RadianceClamp) L *= u_RadianceClamp / lum;

            // Physical radiance: only edge validity gates it (a genuinely invalid
            // screen-edge hit). Distance is NOT a physical attenuation of indirect
            // diffuse, so it must not scale radiance.
            radiance += L * edgeConf;
            // Confidence: edge * distance reliability, used ONLY for temporal and
            // spatial weighting downstream — never multiplied into radiance again.
            confidence += edgeConf * mix(1.0, distConf, 0.5);
            hits += 1;
            if (hit.distance < nearestHit) {
                nearestHit = hit.distance;
                hitDist = hit.distance;
                rangeClass = hit.rangeClass;
            }
        }
    }

    // Normalize by the launched ray count so more rays converge to the same
    // brightness rather than becoming brighter.
    radiance = radiance / float(rayCount) * u_Intensity;
    confidence = confidence / float(rayCount);

    if (any(isnan(radiance)) || any(isinf(radiance))) radiance = vec3(0.0);
    radiance = clamp(radiance, vec3(0.0), vec3(40.0));

    float newStreak = hits > 0 ? 0.0 : min(missStreak + 0.25, 1.0);

    // Encode sample state in aux alpha: <0.5 = valid hit, >=0.5 = evaluated miss.
    float stateAlpha = hits > 0 ? 0.0 : (0.5 + 0.5 * newStreak);

    imageStore(u_OutputRadiance, pixel, vec4(radiance, confidence));
    imageStore(u_OutputAux, pixel, vec4(hitDist, float(rangeClass), confidence, stateAlpha));
}
