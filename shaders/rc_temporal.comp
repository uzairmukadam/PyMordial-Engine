#version 450 core
// ============================================================================
//  Radiance Cascade Temporal Resolve
//
//  Runs exactly once per frame, after the spatial filter. It is the only RC
//  stage that reads history and motion vectors.
//
//  History contract:
//      rgb = resolved incident irradiance
//      a   = positive linear view depth of the pixel that produced rgb
//
//  Rejection: out-of-bounds reprojection, depth mismatch, normal mismatch,
//  high screen-space motion. A camera cut or resize invalidates the history
//  from the CPU side (u_HistoryValid = 0).
//
//  Output: rgb = resolved irradiance, a = this frame's view depth.
// ============================================================================

#include "shaders/common/depth.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) writeonly uniform image2D u_OutputResolved;
layout(binding = 1) uniform sampler2D u_CurrentIrradiance;
layout(binding = 2) uniform sampler2D u_HistoryIrradiance;
layout(binding = 3) uniform sampler2D u_GBufferDepth;
layout(binding = 4) uniform sampler2D u_GBufferNormalMetallic;
layout(binding = 5) uniform sampler2D u_MotionVectors;

layout(std140, binding = 0) uniform FrameData {
    mat4 u_View;
    mat4 u_Projection;
    mat4 u_ViewProjection;
    mat4 u_InvProjection;
    mat4 u_InvView;

    vec4 u_CameraPos_Time;
    vec4 u_ScreenSize_Jitter;

    vec4 u_SunDirection_Intensity;
    vec4 u_SunColor_Ambient;

    mat4 u_LightViewProjection[4];
    vec4 u_CascadeSplits;

    vec4 u_FogColor_Density;
    vec4 u_FogParams;
};

uniform vec2 u_TargetResolution;
uniform mat4 u_PrevView;
uniform float u_TemporalBlend;
uniform int u_HistoryValid;
uniform int u_TemporalEnabled;
uniform int u_DebugView;

vec3 OctahedralDecode(vec2 f) {
    f = f * 2.0 - 1.0;
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_OutputResolved);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / u_TargetResolution;
    float rawDepth = texture(u_GBufferDepth, uv).r;
    if (IsBackgroundDepth(rawDepth)) {
        imageStore(u_OutputResolved, pixel, vec4(0.0));
        return;
    }

    vec4 current = texture(u_CurrentIrradiance, uv);
    if (any(isnan(current)) || any(isinf(current))) {
        current = vec4(0.0);
    }

    vec3 viewPos = ReconstructViewPosition(uv, rawDepth, u_InvProjection);
    float viewDepth = max(-viewPos.z, 0.0);
    vec3 result = current.rgb;
    float depthConfidence = 0.0;
    float motionConfidence = 0.0;
    float historyWeight = 0.0;

    if (u_TemporalEnabled != 0 && u_HistoryValid != 0) {
        vec2 motion = texture(u_MotionVectors, uv).rg;
        vec2 previousUV = uv - motion;

        if (IsUVInBounds(previousUV)) {
            vec4 history = texture(u_HistoryIrradiance, previousUV);

            vec4 worldPos = u_InvView * vec4(viewPos, 1.0);
            vec4 prevViewPos = u_PrevView * worldPos;
            float expectedPrevDepth = abs(prevViewPos.z);
            float depthError = abs(history.a - expectedPrevDepth);
            float depthTolerance = max(0.10, expectedPrevDepth * 0.02);
            depthConfidence = 1.0 - smoothstep(depthTolerance, depthTolerance * 2.0, depthError);

            // Neighbourhood clamp keeps a stale sample from pulling the result
            // away from what this frame measured.
            vec3 clampMargin = max(abs(current.rgb) * 0.35, vec3(0.02));
            vec3 historyRGB = clamp(history.rgb, current.rgb - clampMargin, current.rgb + clampMargin);

            float motionPixels = length(motion * u_TargetResolution);
            motionConfidence = 1.0 - smoothstep(1.0, 8.0, motionPixels);

            historyWeight = clamp(u_TemporalBlend, 0.0, 0.95) * depthConfidence * motionConfidence;
            result = mix(current.rgb, historyRGB, historyWeight);
        }
    }

    if (any(isnan(result)) || any(isinf(result))) {
        result = vec3(0.0);
    }

    if (u_DebugView == 1) {
        imageStore(u_OutputResolved, pixel, vec4(current.rgb, viewDepth));
        return;
    }
    if (u_DebugView == 2) {
        imageStore(u_OutputResolved, pixel, vec4(vec3(depthConfidence), viewDepth));
        return;
    }
    if (u_DebugView == 3) {
        imageStore(u_OutputResolved, pixel, vec4(vec3(motionConfidence), viewDepth));
        return;
    }
    if (u_DebugView == 4) {
        imageStore(u_OutputResolved, pixel, vec4(vec3(historyWeight), viewDepth));
        return;
    }

    imageStore(u_OutputResolved, pixel, vec4(clamp(result, vec3(0.0), vec3(1e4)), viewDepth));
}
