#version 450 core
// ============================================================
//  Froxel Volumetric Fog: Light & Density Injection Pass
//  Computes in-scattering and extinction for each frustum voxel.
// ============================================================

layout (local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout (binding = 0, rgba16f) uniform writeonly image3D u_ScatterExtinctionVol;
layout (binding = 1) uniform sampler2D u_ShadowAtlas;

layout (std140, binding = 0) uniform FrameData {
    mat4 u_View;
    mat4 u_Projection;
    mat4 u_ViewProjection;
    mat4 u_InvProjection;
    mat4 u_InvView;

    vec4 u_CameraPos_Time;
    vec4 u_ScreenSize_Jitter;

    vec4 u_SunDirection_Intensity;
    vec4 u_SunColor_Ambient;

    mat4 u_LightViewProjection[4];
    vec4 u_CascadeSplits;

    vec4 u_FogColor_Density;
    vec4 u_FogParams;
};

// SSBO 3: Dynamic Clustered Local Point Lights
struct PointLightData {
    vec4 pos_radius;      // xyz = position, w = radius
    vec4 color_intensity; // rgb = color, w = intensity
};

layout (std430, binding = 3) readonly buffer PointLightBuffer {
    PointLightData u_PointLights[];
};

uniform int u_CascadeCount = 4;
uniform float u_FogNear = 0.1;
uniform float u_FogFar = 400.0;
uniform float u_FogDensity = 0.005;
uniform float u_FogHeightFalloff = 0.10;
uniform float u_FogAnisotropy = 0.65;
uniform float u_FogAmbient = 0.35;
uniform ivec3 u_GridSize = ivec3(160, 90, 64);
uniform int u_PointLightCount = 0;
uniform bool u_FogPointLights = true;

#define PI 3.14159265359

// Interleaved Gradient Noise for sub-voxel temporal & spatial anti-banding
float InterleavedGradientNoise(vec2 screenPos) {
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(magic.z * fract(dot(screenPos, magic.xy)));
}

// Single-lobe Henyey-Greenstein scattering phase function
float HenyeyGreenstein(float cosTheta, float g) {
    float g2 = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cosTheta;
    return (1.0 - g2) / (4.0 * PI * pow(max(denom, 0.001), 1.5));
}

// AAA Dual-Lobe Henyey-Greenstein phase function:
// Blends forward Mie diffraction (god-rays) with soft backward retro-reflection (silvery rim haze)
float DualLobeHenyeyGreenstein(float cosTheta, float g) {
    float gForward = clamp(g, 0.0, 0.98);
    float pForward = HenyeyGreenstein(cosTheta, gForward);
    float pBack = HenyeyGreenstein(cosTheta, -0.22);
    return mix(pBack, pForward, 0.85);
}

// Simple 3D hash for spatial mist turbulence
float Hash31(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.zyx + 31.32);
    return fract((p.x + p.y) * p.z);
}

float ValueNoise3D(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);

    float n000 = Hash31(i + vec3(0, 0, 0));
    float n100 = Hash31(i + vec3(1, 0, 0));
    float n010 = Hash31(i + vec3(0, 1, 0));
    float n110 = Hash31(i + vec3(1, 1, 0));
    float n001 = Hash31(i + vec3(0, 0, 1));
    float n101 = Hash31(i + vec3(1, 0, 1));
    float n011 = Hash31(i + vec3(0, 1, 1));
    float n111 = Hash31(i + vec3(1, 1, 1));

    float nx00 = mix(n000, n100, u.x);
    float nx10 = mix(n010, n110, u.x);
    float nx01 = mix(n001, n101, u.x);
    float nx11 = mix(n011, n111, u.x);

    float nxy0 = mix(nx00, nx10, u.y);
    float nxy1 = mix(nx01, nx11, u.y);

    return mix(nxy0, nxy1, u.z);
}

// Sample a single cascade shadow map with 4-tap bilinear PCF and soft border feathering
float SampleSingleCascadeShadow(int cascade, vec3 worldPos) {
    vec4 lightClip = u_LightViewProjection[cascade] * vec4(worldPos, 1.0);
    vec3 projCoords = lightClip.xyz / max(lightClip.w, 1e-6);

    // Remap NDC XY [-1, 1] to UV [0, 1]; Z is already in [0, 1] under GL_ZERO_TO_ONE
    projCoords.xy = projCoords.xy * 0.5 + 0.5;
    const vec2 CALIBRATED_SHADOW_OFFSET = vec2(0.0002, 0.0002);
    projCoords.xy += CALIBRATED_SHADOW_OFFSET;

    // Bounds check: if outside light near/far clip range, voxel is unshadowed
    if (projCoords.z < 0.0 || projCoords.z > 1.0) {
        return 1.0;
    }

    // Distance from cascade border in UV space [0, 1]
    vec2 borderDist = min(projCoords.xy, 1.0 - projCoords.xy);
    float edgeFactor = min(borderDist.x, borderDist.y);
    if (edgeFactor <= 0.0) {
        return 1.0; // Outside XY cascade bounds
    }

    vec2 atlasOffset = vec2(float(cascade % 2) * 0.5, float(cascade / 2) * 0.5);
    vec2 uv = projCoords.xy * 0.5 + atlasOffset;
    vec2 uvMin = atlasOffset + vec2(0.0005);
    vec2 uvMax = atlasOffset + vec2(0.4995);

    // 4-Tap Bilinear PCF filtering inside the cascade quadrant
    vec2 fullSize = vec2(textureSize(u_ShadowAtlas, 0));
    vec2 texelSize = 1.0 / fullSize;
    vec2 pos = uv * fullSize - 0.5;
    vec2 f = fract(pos);
    vec2 baseUV = (floor(pos) + 0.5) * texelSize;

    float currentDepth = projCoords.z;
    float bias = 0.0012;

    float d00 = texture(u_ShadowAtlas, clamp(baseUV, uvMin, uvMax)).r;
    float d10 = texture(u_ShadowAtlas, clamp(baseUV + vec2(texelSize.x, 0.0), uvMin, uvMax)).r;
    float d01 = texture(u_ShadowAtlas, clamp(baseUV + vec2(0.0, texelSize.y), uvMin, uvMax)).r;
    float d11 = texture(u_ShadowAtlas, clamp(baseUV + texelSize, uvMin, uvMax)).r;

    float s00 = (currentDepth > d00 + bias) ? 0.0 : 1.0;
    float s10 = (currentDepth > d10 + bias) ? 0.0 : 1.0;
    float s01 = (currentDepth > d01 + bias) ? 0.0 : 1.0;
    float s11 = (currentDepth > d11 + bias) ? 0.0 : 1.0;

    float shadowVal = mix(mix(s00, s10, f.x), mix(s01, s11, f.x), f.y);

    // Smooth edge blend: feathers into 1.0 at cascade border to eliminate any sharp seams
    float borderFade = smoothstep(0.0, 0.08, edgeFactor);
    return mix(1.0, shadowVal, borderFade);
}

// CSM Shadow Test for a 3D point in world space with seamless split transitions
float EvaluateCSMShadow(vec3 worldPos, float viewDepth) {
    float maxShadowDist = u_CascadeSplits[u_CascadeCount - 1];
    if (viewDepth >= maxShadowDist) {
        return 1.0;
    }

    int cascade = 0;
    for (int c = 0; c < u_CascadeCount - 1; ++c) {
        if (viewDepth > u_CascadeSplits[c]) {
            cascade = c + 1;
        }
    }

    float shadow = SampleSingleCascadeShadow(cascade, worldPos);

    // Smooth cascade split transition blending to eliminate seams
    if (cascade < u_CascadeCount - 1) {
        float splitVal = u_CascadeSplits[cascade];
        float blendRange = splitVal * 0.20;
        float blendStart = splitVal - blendRange;
        if (viewDepth > blendStart) {
            float blendT = clamp((viewDepth - blendStart) / blendRange, 0.0, 1.0);
            float nextShadow = SampleSingleCascadeShadow(cascade + 1, worldPos);
            shadow = mix(shadow, nextShadow, blendT);
        }
    } else {
        // Final cascade: smooth distance fade-out towards max shadow distance
        float fadeRange = maxShadowDist * 0.20;
        float fadeStart = maxShadowDist - fadeRange;
        if (viewDepth > fadeStart) {
            float fadeT = clamp((viewDepth - fadeStart) / max(fadeRange, 0.001), 0.0, 1.0);
            shadow = mix(shadow, 1.0, fadeT);
        }
    }

    return shadow;
}

void main() {
    ivec3 voxel = ivec3(gl_GlobalInvocationID.xyz);
    if (voxel.x >= u_GridSize.x || voxel.y >= u_GridSize.y || voxel.z >= u_GridSize.z) {
        return;
    }

    // Normalized coordinates with sub-voxel depth jitter (IGN)
    vec2 uv = (vec2(voxel.xy) + 0.5) / vec2(u_GridSize.xy);
    float ign = InterleavedGradientNoise(vec2(voxel.xy));
    float sliceJitter = (ign - 0.5) * 0.40;
    float sliceFactor = clamp((float(voxel.z) + 0.5 + sliceJitter) / float(u_GridSize.z), 0.001, 0.999);

    // Logarithmic depth distribution along frustum Z
    float viewDepth = u_FogNear * pow(u_FogFar / u_FogNear, sliceFactor);

    // Reconstruct position in view space
    vec3 ndc = vec3(uv * 2.0 - 1.0, 0.5);
    vec4 rayView = u_InvProjection * vec4(ndc, 1.0);
    vec3 rayDir = rayView.xyz / rayView.w;
    vec3 viewPos = rayDir * (-viewDepth / rayDir.z);

    // Transform to world space
    vec3 worldPos = (u_InvView * vec4(viewPos, 1.0)).xyz;

    // Height-based exponential fog density with animated mist wind flow
    float baseHeight = 0.0;
    float h = max(worldPos.y - baseHeight, 0.0);
    float heightDensity = exp(-h * u_FogHeightFalloff);

    // 3D noise for gentle rolling mist with wind drift
    float time = u_CameraPos_Time.w;
    vec3 windOffset = vec3(time * 0.35, 0.0, time * 0.15);
    vec3 noiseCoord = (worldPos + windOffset) * 0.06;
    float noise = ValueNoise3D(noiseCoord);
    float density = u_FogDensity * heightDensity * mix(0.70, 1.30, noise);

    // Compute in-scattering
    vec3 V = normalize(u_CameraPos_Time.xyz - worldPos);
    vec3 L = normalize(-u_SunDirection_Intensity.xyz);
    float cosTheta = dot(-V, L);

    float phase = DualLobeHenyeyGreenstein(cosTheta, u_FogAnisotropy);
    float shadow = EvaluateCSMShadow(worldPos, viewDepth);

    // Direct sun radiance scattered towards the camera
    vec3 sunColor = u_SunColor_Ambient.rgb;
    float sunLux = u_SunDirection_Intensity.w;
    vec3 directScattering = sunColor * sunLux * phase * shadow;

    // Ambient hemisphere illumination scattered towards the camera:
    // Natural sky-ground gradient: warm earth bounce from below, radiant blue sky from above
    vec3 skyLight = vec3(0.65, 0.75, 0.88);
    vec3 groundLight = vec3(0.28, 0.24, 0.20);
    vec3 ambientHemisphere = mix(groundLight, skyLight, clamp(worldPos.y * 0.05 + 0.3, 0.0, 1.0));
    vec3 ambientScattering = ambientHemisphere * u_FogAmbient;

    // Clustered / local point light volumetric scattering
    vec3 pointLightsScattering = vec3(0.0);
    if (u_FogPointLights && u_PointLightCount > 0) {
        int activeCount = min(u_PointLightCount, 32);
        for (int i = 0; i < activeCount; ++i) {
            vec3 lightPos = u_PointLights[i].pos_radius.xyz;
            float radius = u_PointLights[i].pos_radius.w;
            vec3 delta = lightPos - worldPos;
            float dist = length(delta);

            if (dist < radius) {
                vec3 plDir = delta / max(dist, 0.001);
                float plCosTheta = dot(-V, plDir);
                float plPhase = HenyeyGreenstein(plCosTheta, 0.20);

                float ratio = dist / radius;
                float win = clamp(1.0 - ratio * ratio * ratio * ratio, 0.0, 1.0);
                float atten = (win * win) / (dist * dist + 1.0);

                vec3 plRadiance = u_PointLights[i].color_intensity.rgb * u_PointLights[i].color_intensity.w;
                pointLightsScattering += plRadiance * plPhase * atten;
            }
        }
    }

    vec3 totalScattering = (directScattering + ambientScattering + pointLightsScattering) * density;
    float extinction = density;

    imageStore(u_ScatterExtinctionVol, voxel, vec4(totalScattering, extinction));
}
