#version 450 core
// ============================================================================
//  Hi-Z Bounds API Validation Shader
//
//  Evaluates the shared bounds helpers for a table of ray intervals and writes
//  one result row per invocation so Python can verify the interval semantics.
//
//  Output (rgba32f, one row per test case):
//      r = overlap flag (0/1)
//      g = loaded nearest
//      b = loaded farthest
//      a = empty flag (0/1)
// ============================================================================

#include "shaders/common/hiz_bounds.glsl"

layout(local_size_x = 1, local_size_y = 1) in;

layout(binding = 0) uniform sampler2D u_HiZTexture;
layout(rgba32f, binding = 0) uniform writeonly image2D u_Output;

uniform int u_TestCount;
uniform vec2 u_RayIntervals[64];   // xy = (nearest, farthest) per test
uniform float u_Thickness = 0.0;
uniform ivec2 u_Cell = ivec2(0);
uniform int u_Mip = 0;

void main() {
    int index = int(gl_GlobalInvocationID.x);
    if (index >= u_TestCount) {
        return;
    }

    HiZDepthBounds bounds = LoadHiZBounds(u_HiZTexture, u_Cell, u_Mip);
    vec2 ray = u_RayIntervals[index];
    bool overlap = DepthIntervalsOverlap(ray.x, ray.y, bounds, u_Thickness);

    imageStore(
        u_Output,
        ivec2(index, 0),
        vec4(overlap ? 1.0 : 0.0, bounds.nearest, bounds.farthest, HiZBoundsEmpty(bounds) ? 1.0 : 0.0)
    );
}
