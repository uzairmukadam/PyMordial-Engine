#version 450 core
// ============================================================================
//  Radiance Cascade Reconstruction
//
//  Converts the merged C0 directional probe field into per-pixel incident
//  diffuse irradiance.
//
//  OUTPUT CONTRACT
//      RGB = incident diffuse irradiance (NOT radiance, NOT albedo-weighted)
//      A   = reconstruction confidence in [0, 1]
//
//  The receiver's albedo and metallic suppression are deliberately NOT applied
//  here. The deferred resolve applies the receiver diffuse BRDF exactly once,
//  so applying albedo here would double-multiply it.
//
//  Reconstruction:
//      1. Reconstruct the receiver position and normal.
//      2. Bilinearly gather the four neighbouring C0 probes.
//      3. Weight each probe by spatial weight, depth compatibility, normal
//         compatibility and probe validity.
//      4. For each direction, apply max(dot(N, dir), 0) and integrate.
//      5. Normalise by the sampled solid angle so the result is irradiance.
// ============================================================================

#include "shaders/common/depth.glsl"
#include "shaders/common/rc_direction.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) writeonly uniform image2D u_OutputIrradiance;
layout(binding = 1) uniform sampler2DArray u_MergedC0;
layout(binding = 2) uniform sampler2D u_GBufferDepth;
layout(binding = 3) uniform sampler2D u_GBufferNormalMetallic;

layout(std140, binding = 0) uniform FrameData {
    mat4 u_View;
    mat4 u_Projection;
    mat4 u_ViewProjection;
    mat4 u_InvProjection;
    mat4 u_InvView;

    vec4 u_CameraPos_Time;
    vec4 u_ScreenSize_Jitter;

    vec4 u_SunDirection_Intensity;
    vec4 u_SunColor_Ambient;

    mat4 u_LightViewProjection[4];
    vec4 u_CascadeSplits;

    vec4 u_FogColor_Density;
    vec4 u_FogParams;
};

uniform vec2 u_TargetResolution;
uniform ivec2 u_ProbeSize;
uniform int u_DirectionCount;
uniform int u_DebugView;

vec3 OctahedralDecode(vec2 f) {
    f = f * 2.0 - 1.0;
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_OutputIrradiance);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / u_TargetResolution;
    float raw_depth = texture(u_GBufferDepth, uv).r;
    if (IsBackgroundDepth(raw_depth)) {
        imageStore(u_OutputIrradiance, pixel, vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }

    vec3 view_pos = ReconstructViewPosition(uv, raw_depth, u_InvProjection);
    vec3 normal_world = OctahedralDecode(texture(u_GBufferNormalMetallic, uv).rg);
    vec3 normal_view = normalize(mat3(u_View) * normal_world);
    float receiver_depth = max(-view_pos.z, 0.0);

    // Bilinear gather of the four neighbouring C0 probes.
    vec2 probeCoord = uv * vec2(u_ProbeSize) - 0.5;
    ivec2 base = ivec2(floor(probeCoord));
    vec2 frac = probeCoord - vec2(base);

    vec3 irradiance = vec3(0.0);
    float weightSum = 0.0;
    float rejected = 0.0;

    for (int dy = 0; dy <= 1; ++dy) {
        for (int dx = 0; dx <= 1; ++dx) {
            ivec2 probe = clamp(base + ivec2(dx, dy), ivec2(0), u_ProbeSize - 1);
            float spatialWeight = (dx == 0 ? 1.0 - frac.x : frac.x) * (dy == 0 ? 1.0 - frac.y : frac.y);
            if (spatialWeight <= 0.0) {
                continue;
            }

            // Probe validity: a probe whose centre is background has no data.
            vec2 probeUV = (vec2(probe) + 0.5) / vec2(u_ProbeSize);
            float probeRawDepth = texture(u_GBufferDepth, probeUV).r;
            if (IsBackgroundDepth(probeRawDepth)) {
                rejected += spatialWeight;
                continue;
            }

            vec3 probePos = ReconstructViewPosition(probeUV, probeRawDepth, u_InvProjection);
            vec3 probeNormal = normalize(mat3(u_View) * OctahedralDecode(texture(u_GBufferNormalMetallic, probeUV).rg));

            // Depth compatibility: reject probes on a different surface.
            float depthDelta = abs(-probePos.z - receiver_depth);
            float depthTolerance = max(0.25, receiver_depth * 0.05);
            float depthWeight = 1.0 - smoothstep(depthTolerance, depthTolerance * 2.0, depthDelta);

            // Normal compatibility: reject probes across a sharp crease.
            float normalWeight = pow(max(dot(normal_view, probeNormal), 0.0), 8.0);

            float weight = spatialWeight * depthWeight * normalWeight;
            if (weight <= 1e-5) {
                rejected += spatialWeight;
                continue;
            }

            // Integrate the probe's directional intervals over the receiver
            // hemisphere. Each direction contributes its radiance weighted by
            // the cosine term and the solid angle it represents.
            vec3 probeIrradiance = vec3(0.0);
            for (int d = 0; d < u_DirectionCount; ++d) {
                vec3 dir = RCDirection(d, u_DirectionCount);
                float cosine = max(dot(normal_view, dir), 0.0);
                if (cosine <= 0.0) {
                    continue;
                }
                vec4 interval = texelFetch(u_MergedC0, ivec3(probe, d), 0);
                if (any(isnan(interval)) || any(isinf(interval))) {
                    continue;
                }
                probeIrradiance += interval.rgb * cosine;
            }
            probeIrradiance *= RCDirectionSolidAngle(u_DirectionCount);

            irradiance += probeIrradiance * weight;
            weightSum += weight;
        }
    }

    float confidence = weightSum > 0.0 ? clamp(weightSum, 0.0, 1.0) : 0.0;
    vec3 result = weightSum > 0.0 ? irradiance / weightSum : vec3(0.0);

    if (any(isnan(result)) || any(isinf(result))) {
        result = vec3(0.0);
        confidence = 0.0;
    }

    if (u_DebugView == 1) {
        imageStore(u_OutputIrradiance, pixel, vec4(result, confidence));
        return;
    }
    if (u_DebugView == 2) {
        imageStore(u_OutputIrradiance, pixel, vec4(vec3(confidence), confidence));
        return;
    }
    if (u_DebugView == 3) {
        imageStore(u_OutputIrradiance, pixel, vec4(vec3(rejected), confidence));
        return;
    }

    imageStore(u_OutputIrradiance, pixel, vec4(clamp(result, vec3(0.0), vec3(1e4)), confidence));
}
