#version 450 core
// ============================================================
//  PyMordial Engine: GPU-Driven Occlusion Culling via Hi-Z Depth
//
//  Decima-Style Two-Phase Culling:
//  1. Read entity world-space bounding box from AABB SSBO (binding = 5)
//  2. Evaluate frustum plane clipping against camera view-projection
//  3. Project bounding box extents to screen space and determine Hi-Z mip
//  4. Sample Hi-Z depth mip and test against nearest occluder depth
//  5. Write surviving instance indices or visibility bitmask
// ============================================================

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Bounding box: [cx, cy, cz, ex, ey, ez] (centers and half-extents)
layout(std430, binding = 5) readonly buffer AABBBuffer {
    vec4 u_AABBData[]; // xyz = center, w = extent.x; next xyz = extent.y, extent.z, flags
};

// Visibility bitmask or indexed instance list output
layout(std430, binding = 6) writeonly buffer VisibilityBuffer {
    uint u_VisibleMask[];
};

layout(binding = 0) uniform sampler2D u_HiZTexture;

uniform mat4 u_ViewProjection;
uniform vec2 u_ScreenSize;
uniform int  u_EntityCount;
uniform int  u_HiZMipCount;
uniform int  u_ReverseZ; // 1 = Reversed-Z (1.0 near, 0.0 far), 0 = Standard-Z

// 8 bounding box corners in homogeneous clip space
void GetBoxCorners(vec3 center, vec3 extents, out vec4 corners[8]) {
    vec3 c0 = center + vec3(-extents.x, -extents.y, -extents.z);
    vec3 c1 = center + vec3( extents.x, -extents.y, -extents.z);
    vec3 c2 = center + vec3(-extents.x,  extents.y, -extents.z);
    vec3 c3 = center + vec3( extents.x,  extents.y, -extents.z);
    vec3 c4 = center + vec3(-extents.x, -extents.y,  extents.z);
    vec3 c5 = center + vec3( extents.x, -extents.y,  extents.z);
    vec3 c6 = center + vec3(-extents.x,  extents.y,  extents.z);
    vec3 c7 = center + vec3( extents.x,  extents.y,  extents.z);

    corners[0] = u_ViewProjection * vec4(c0, 1.0);
    corners[1] = u_ViewProjection * vec4(c1, 1.0);
    corners[2] = u_ViewProjection * vec4(c2, 1.0);
    corners[3] = u_ViewProjection * vec4(c3, 1.0);
    corners[4] = u_ViewProjection * vec4(c4, 1.0);
    corners[5] = u_ViewProjection * vec4(c5, 1.0);
    corners[6] = u_ViewProjection * vec4(c6, 1.0);
    corners[7] = u_ViewProjection * vec4(c7, 1.0);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(u_EntityCount)) {
        return;
    }

    // Read AABB from contiguous memory
    vec4 d0 = u_AABBData[idx * 2 + 0];
    vec4 d1 = u_AABBData[idx * 2 + 1];
    vec3 center  = d0.xyz;
    vec3 extents = vec3(d0.w, d1.xy);

    vec4 corners[8];
    GetBoxCorners(center, extents, corners);

    // 1. Frustum Culling
    // In NDC with GL_ZERO_TO_ONE, inside frustum means:
    // -w <= x <= w, -w <= y <= w, 0 <= z <= w (or 0 <= z <= w in Reversed-Z)
    int outLeft = 0, outRight = 0, outBottom = 0, outTop = 0, outNear = 0, outFar = 0;
    for (int i = 0; i < 8; ++i) {
        float w = corners[i].w;
        if (corners[i].x < -w) outLeft++;
        if (corners[i].x >  w) outRight++;
        if (corners[i].y < -w) outBottom++;
        if (corners[i].y >  w) outTop++;
        if (u_ReverseZ == 1) {
            if (corners[i].z < 0.0) outFar++;
            if (corners[i].z > w)   outNear++;
        } else {
            if (corners[i].z < 0.0) outNear++;
            if (corners[i].z > w)   outFar++;
        }
    }

    if (outLeft == 8 || outRight == 8 || outBottom == 8 || outTop == 8 || outNear == 8 || outFar == 8) {
        u_VisibleMask[idx] = 0;
        return;
    }

    // 2. Screen-Space Projected AABB Bounds
    vec3 minNDC = vec3(1e6);
    vec3 maxNDC = vec3(-1e6);
    bool intersectsNearPlane = false;

    for (int i = 0; i < 8; ++i) {
        if (corners[i].w <= 0.01) {
            intersectsNearPlane = true;
            break;
        }
        vec3 ndc = corners[i].xyz / corners[i].w;
        minNDC = min(minNDC, ndc);
        maxNDC = max(maxNDC, ndc);
    }

    // If AABB intersects near camera plane, skip Hi-Z test and mark visible
    if (intersectsNearPlane) {
        u_VisibleMask[idx] = 1;
        return;
    }

    // Convert NDC [-1, 1] to UV [0, 1]
    vec2 minUV = clamp(minNDC.xy * 0.5 + 0.5, vec2(0.0), vec2(1.0));
    vec2 maxUV = clamp(maxNDC.xy * 0.5 + 0.5, vec2(0.0), vec2(1.0));

    // Screen pixel footprint
    vec2 sizePx = (maxUV - minUV) * u_ScreenSize;
    float maxDim = max(sizePx.x, sizePx.y);

    if (maxDim <= 0.0) {
        u_VisibleMask[idx] = 0;
        return;
    }

    // 3. Hi-Z Mip Level Selection
    // Select mip level where AABB footprint is roughly 1-2 texels
    float mipLevel = clamp(ceil(log2(max(maxDim, 1.0))), 0.0, float(u_HiZMipCount - 1));

    // Sample the 4 bounding texels in Hi-Z pyramid
    vec2 uv0 = minUV;
    vec2 uv1 = vec2(maxUV.x, minUV.y);
    vec2 uv2 = vec2(minUV.x, maxUV.y);
    vec2 uv3 = maxUV;

    float depth0 = textureLod(u_HiZTexture, uv0, mipLevel).r;
    float depth1 = textureLod(u_HiZTexture, uv1, mipLevel).r;
    float depth2 = textureLod(u_HiZTexture, uv2, mipLevel).r;
    float depth3 = textureLod(u_HiZTexture, uv3, mipLevel).r;

    // Nearest occluder depth in the sampled region
    float occluderDepth;
    if (u_ReverseZ == 1) {
        // Reversed-Z: larger = closer. In Hi-Z downsample, min represents the furthest occluder
        // For occlusion, we test if the closest point on the object is behind the furthest occluder
        occluderDepth = min(min(depth0, depth1), min(depth2, depth3));
        // Object closest point in Reversed-Z is maxNDC.z
        float objectDepth = maxNDC.z;
        // If object's closest point is further away than the occluder (smaller in Reversed-Z), it is occluded
        if (objectDepth < occluderDepth) {
            u_VisibleMask[idx] = 0;
            return;
        }
    } else {
        // Standard-Z: smaller = closer.
        occluderDepth = max(max(depth0, depth1), max(depth2, depth3));
        float objectDepth = minNDC.z;
        if (objectDepth > occluderDepth) {
            u_VisibleMask[idx] = 0;
            return;
        }
    }

    u_VisibleMask[idx] = 1;
}
