#version 450 core
// ============================================================================
//  Radiance Cascade Spatial Filter
//
//  Edge-aware 5x5 bilateral filter over the reconstructed per-pixel irradiance.
//  It never reads temporal history: temporal accumulation is a separate stage
//  (rc_temporal.comp) that runs exactly once per frame.
//
//  Output: rgb = filtered irradiance, a = filtered confidence.
// ============================================================================

#include "shaders/common/depth.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) writeonly uniform image2D u_OutputFiltered;
layout(binding = 1) uniform sampler2D u_InputIrradiance;
layout(binding = 2) uniform sampler2D u_GBufferDepth;
layout(binding = 3) uniform sampler2D u_GBufferNormalMetallic;

layout(std140, binding = 0) uniform FrameData {
    mat4 u_View;
    mat4 u_Projection;
    mat4 u_ViewProjection;
    mat4 u_InvProjection;
    mat4 u_InvView;

    vec4 u_CameraPos_Time;
    vec4 u_ScreenSize_Jitter;

    vec4 u_SunDirection_Intensity;
    vec4 u_SunColor_Ambient;

    mat4 u_LightViewProjection[4];
    vec4 u_CascadeSplits;

    vec4 u_FogColor_Density;
    vec4 u_FogParams;
};

uniform vec2 u_TargetResolution;

vec3 OctahedralDecode(vec2 f) {
    f = f * 2.0 - 1.0;
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_OutputFiltered);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / u_TargetResolution;
    float centerRaw = texture(u_GBufferDepth, uv).r;
    if (IsBackgroundDepth(centerRaw)) {
        imageStore(u_OutputFiltered, pixel, vec4(0.0));
        return;
    }

    vec3 centerPos = ReconstructViewPosition(uv, centerRaw, u_InvProjection);
    vec3 centerNormal = normalize(mat3(u_View) * OctahedralDecode(texture(u_GBufferNormalMetallic, uv).rg));
    float depthSigma = max(0.08, abs(centerPos.z) * 0.012);
    vec2 texel = 1.0 / u_TargetResolution;

    const float kernel[5] = float[](1.0, 4.0, 6.0, 4.0, 1.0);
    vec3 sum = vec3(0.0);
    float confidenceSum = 0.0;
    float weightSum = 0.0;
    float radianceWeightSum = 0.0;

    for (int y = -2; y <= 2; ++y) {
        for (int x = -2; x <= 2; ++x) {
            vec2 sampleUV = uv + vec2(x, y) * texel;
            if (!IsUVInBounds(sampleUV)) {
                continue;
            }
            float sampleRaw = texture(u_GBufferDepth, sampleUV).r;
            if (IsBackgroundDepth(sampleRaw)) {
                continue;
            }
            vec3 samplePos = ReconstructViewPosition(sampleUV, sampleRaw, u_InvProjection);
            vec3 sampleNormal = normalize(mat3(u_View) * OctahedralDecode(texture(u_GBufferNormalMetallic, sampleUV).rg));

            float planeDistance = abs(dot(centerNormal, samplePos - centerPos));
            float normalWeight = pow(max(dot(centerNormal, sampleNormal), 0.0), 24.0);

            // Independent view-depth rejection: plane distance alone cannot
            // separate two surfaces that are parallel to the receiver's plane
            // but sit at a different distance.
            float centerDepth = max(-centerPos.z, 0.0);
            float sampleDepth = max(-samplePos.z, 0.0);
            float viewDepthDelta = abs(sampleDepth - centerDepth);
            float viewDepthTolerance = max(0.03, centerDepth * 0.003);
            float viewDepthWeight = 1.0 - smoothstep(
                viewDepthTolerance,
                viewDepthTolerance * 2.0,
                viewDepthDelta
            );

            float weight = kernel[x + 2] * kernel[y + 2] * exp(-planeDistance / depthSigma)
                         * normalWeight * viewDepthWeight;
            if (weight <= 1e-6) {
                continue;
            }

            vec4 tap = texture(u_InputIrradiance, sampleUV);
            if (any(isnan(tap)) || any(isinf(tap))) {
                continue;
            }
            // A tap with no reconstruction confidence carries no radiance, so
            // it must not darken its neighbours. Confidence gates the RGB
            // contribution only; the confidence output keeps its own average.
            float radianceWeight = weight * clamp(tap.a, 0.0, 1.0);
            if (radianceWeight <= 1e-6) {
                continue;
            }
            sum += tap.rgb * radianceWeight;
            radianceWeightSum += radianceWeight;
            confidenceSum += tap.a * weight;
            weightSum += weight;
        }
    }

    vec3 result = radianceWeightSum > 0.0 ? sum / radianceWeightSum : vec3(0.0);
    float confidence = weightSum > 0.0 ? confidenceSum / weightSum : 0.0;
    imageStore(u_OutputFiltered, pixel, vec4(clamp(result, vec3(0.0), vec3(1e4)), clamp(confidence, 0.0, 1.0)));
}
