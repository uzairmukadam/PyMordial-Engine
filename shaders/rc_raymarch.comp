#version 430 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) writeonly uniform image2D u_OutputRadiance;
layout(binding = 1) uniform sampler2D u_GBufferDepth;
layout(binding = 2) uniform sampler2D u_GBufferNormalMetallic;
layout(binding = 3) uniform sampler2D u_GBufferAlbedoRoughness;
layout(binding = 4) uniform sampler2D u_GBufferSurfaceID;

layout(std140, binding = 0) uniform FrameData {
    mat4 u_View;
    mat4 u_Projection;
    mat4 u_ViewProjection;
    mat4 u_InvProjection;
    mat4 u_InvView;
    vec4 u_CameraPos_Time;
    vec4 u_ScreenSize_Jitter;
    vec4 u_SunDirection_Intensity;
    vec4 u_SunColor_Ambient;
    mat4 u_LightViewProjection[4];
    vec4 u_CascadeSplits;
    vec4 u_FogColor_Density;
    vec4 u_FogParams;
};

uniform vec2 u_TargetResolution;
uniform float u_RC_IntervalC0;
uniform float u_RC_IntervalC1;
uniform float u_RC_IntervalC2;
uniform int u_RC_StepsC0;
uniform int u_RC_StepsC1;
uniform float u_RC_Thickness;
uniform float u_RC_Intensity;

const float PI = 3.14159265359;
const float GOLDEN_RATIO = 1.61803398875;
const int RAY_COUNT = 32;

vec3 OctahedralDecode(vec2 f) {
    f = f * 2.0 - 1.0;
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    return normalize(n);
}

vec3 ViewPosition(vec2 uv, float depth) {
    vec4 p = u_InvProjection * vec4(uv * 2.0 - 1.0, depth, 1.0);
    return p.xyz / max(abs(p.w), 1e-6);
}

vec3 CosineHemisphereRay(int index, vec3 n, float rotation) {
    float phi = 2.0 * PI * fract(float(index) * GOLDEN_RATIO + rotation);
    float cosTheta = sqrt((float(index) + 0.5) / float(RAY_COUNT));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));
    vec3 h = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
    vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, n));
    return normalize(tangent * h.x + cross(n, tangent) * h.y + n * h.z);
}

float InterleavedNoise(vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

vec3 SurfaceRadiance(vec2 uv) {
    vec4 packedAlbedo = texture(u_GBufferAlbedoRoughness, uv);
    vec3 rawAlbedo = packedAlbedo.rgb;
    float maxChannel = max(max(rawAlbedo.r, rawAlbedo.g), rawAlbedo.b);
    vec3 albedo = maxChannel > 1.0 ? rawAlbedo / maxChannel : rawAlbedo;
    vec3 emissive = maxChannel > 1.0 ? rawAlbedo - albedo : vec3(0.0);

    vec3 hitNormal = normalize(mat3(u_View) * OctahedralDecode(texture(u_GBufferNormalMetallic, uv).rg));
    vec3 sunDirection = normalize(mat3(u_View) * -u_SunDirection_Intensity.xyz);
    float sun = max(dot(hitNormal, sunDirection), 0.0);
    vec3 direct = albedo * u_SunColor_Ambient.rgb * (u_SunDirection_Intensity.w * sun / PI);
    vec3 ambient = albedo * u_SunColor_Ambient.rgb * max(u_SunColor_Ambient.w, 0.025) * 0.35;

    // Limit single-hit fireflies so tiny bright samples cannot dominate corner bounce.
    vec3 radiance = emissive + direct + ambient;
    float luminance = dot(radiance, vec3(0.2126, 0.7152, 0.0722));
    radiance *= min(1.0, 2.0 / max(luminance, 1e-5));
    return min(radiance, vec3(2.0));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(u_OutputRadiance);
    if (pixel.x >= outputSize.x || pixel.y >= outputSize.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / u_TargetResolution;
    float depth = texture(u_GBufferDepth, uv).r;
    if (depth <= 1e-6) {
        imageStore(u_OutputRadiance, pixel, vec4(0.0));
        return;
    }

    vec3 origin = ViewPosition(uv, depth);
    vec3 normalView = normalize(mat3(u_View) * OctahedralDecode(texture(u_GBufferNormalMetallic, uv).rg));
    float originSurfaceID = texture(u_GBufferSurfaceID, uv).r;
    origin += normalView * max(0.025, abs(origin.z) * 0.0005);

    float frameIndex = floor(u_CameraPos_Time.w * 30.0);
    float noise = InterleavedNoise(vec2(pixel) + vec2(frameIndex * 17.0, frameIndex * 31.0));
    vec3 incomingRadiance = vec3(0.0);
    float hitWeight = 0.0;
    int nearSteps = clamp(u_RC_StepsC0, 2, 12);
    int midSteps = clamp(u_RC_StepsC1, 2, 16);
    int farSteps = 6;

    for (int ray = 0; ray < RAY_COUNT; ++ray) {
        vec3 direction = CosineHemisphereRay(ray, normalView, noise);
        float hitDistance = 0.0;
        vec2 hitUV = vec2(0.0);
        bool hit = false;

        for (int step = 0; step < nearSteps + midSteps + farSteps; ++step) {
            float t;
            if (step < nearSteps) {
                t = u_RC_IntervalC0 * (float(step) + 0.5 + noise) / float(nearSteps);
            } else if (step < nearSteps + midSteps) {
                int midStep = step - nearSteps;
                t = mix(u_RC_IntervalC0, u_RC_IntervalC1,
                    (float(midStep) + 0.5 + noise) / float(midSteps));
            } else {
                int farStep = step - nearSteps - midSteps;
                t = mix(u_RC_IntervalC1, u_RC_IntervalC2,
                    (float(farStep) + 0.5 + noise) / float(farSteps));
            }

            vec3 rayPosition = origin + direction * t;
            vec4 clip = u_Projection * vec4(rayPosition, 1.0);
            if (clip.w <= 1e-5) {
                break;
            }
            vec2 sampleUV = clip.xy / clip.w * 0.5 + 0.5;
            if (any(lessThan(sampleUV, vec2(0.0))) || any(greaterThan(sampleUV, vec2(1.0)))) {
                break;
            }
            if (distance(sampleUV, uv) < 0.006 || t < max(u_RC_IntervalC0 * 0.5, 0.08)) {
                continue;
            }

            float sceneDepth = texture(u_GBufferDepth, sampleUV).r;
            if (sceneDepth <= 1e-6) {
                continue;
            }

            float sceneZ = ViewPosition(sampleUV, sceneDepth).z;
            float depthDelta = sceneZ - rayPosition.z;
            float thickness = max(u_RC_Thickness, t * 0.003);
            if (depthDelta >= 0.0 && depthDelta < thickness) {
                float hitSurfaceID = texture(u_GBufferSurfaceID, sampleUV).r;
                vec3 hitNormal = normalize(mat3(u_View) * OctahedralDecode(
                    texture(u_GBufferNormalMetallic, sampleUV).rg
                ));
                vec3 hitPosition = ViewPosition(sampleUV, sceneDepth);
                float tangentDistance = abs(dot(normalView, hitPosition - origin));
                bool sameSurface = originSurfaceID > 0.0 &&
                    abs(hitSurfaceID - originSurfaceID) < 0.25 &&
                    dot(normalView, hitNormal) > 0.96 &&
                    tangentDistance < max(0.03, t * 0.02);
                if (sameSurface) {
                    continue;
                }
                hit = true;
                hitUV = sampleUV;
                hitDistance = t;
                break;
            }
        }

        if (hit) {
            vec3 hitNormal = normalize(mat3(u_View) * OctahedralDecode(texture(u_GBufferNormalMetallic, hitUV).rg));
            if (dot(hitNormal, -direction) > 0.0) {
                float distanceFade = clamp(1.0 - hitDistance / max(u_RC_IntervalC2, 1e-3), 0.0, 1.0);
                vec2 edge = smoothstep(vec2(0.0), vec2(0.06), hitUV)
                          * (1.0 - smoothstep(vec2(0.94), vec2(1.0), hitUV));
                float confidence = edge.x * edge.y * distanceFade;
                incomingRadiance += SurfaceRadiance(hitUV) * confidence;
                hitWeight += confidence;
            }
        }
    }

    vec3 irradiance = incomingRadiance * (u_RC_Intensity / float(RAY_COUNT));
    float irradianceLuminance = dot(irradiance, vec3(0.2126, 0.7152, 0.0722));
    irradiance *= min(1.0, 2.0 / max(irradianceLuminance, 1e-5));
    irradiance = min(irradiance, vec3(2.0));
    if (any(isnan(irradiance)) || any(isinf(irradiance))) {
        irradiance = vec3(0.0);
    }
    imageStore(u_OutputRadiance, pixel, vec4(irradiance, hitWeight / float(RAY_COUNT)));
}
