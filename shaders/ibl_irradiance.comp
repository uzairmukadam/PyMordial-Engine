#version 430 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) writeonly uniform image2D u_Irradiance;
layout(binding = 0) uniform sampler2D u_EnvironmentSource;

uniform vec2 u_OutputSize;

const float PI = 3.14159265359;
const uint SAMPLE_COUNT = 128u;

float RadicalInverseVdC(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits << 1u) & 0x55555555u) | ((bits >> 1u) & 0xAAAAAAAAu);
    bits = ((bits << 2u) & 0x33333333u) | ((bits >> 2u) & 0xCCCCCCCCu);
    bits = ((bits << 4u) & 0x0F0F0F0Fu) | ((bits >> 4u) & 0xF0F0F0F0u);
    bits = ((bits << 8u) & 0x00FF00FFu) | ((bits >> 8u) & 0xFF00FF00u);
    bits = (bits << 16u) | (bits >> 16u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 Hammersley(uint i) {
    return vec2(float(i) / float(SAMPLE_COUNT), RadicalInverseVdC(i));
}

vec3 DirectionFromEquirect(vec2 uv) {
    float longitude = (uv.x - 0.5) * 2.0 * PI;
    float latitude = (uv.y - 0.5) * PI;
    float cosLatitude = cos(latitude);
    return vec3(cosLatitude * cos(longitude), sin(latitude), cosLatitude * sin(longitude));
}

vec2 EquirectUV(vec3 direction) {
    return vec2(atan(direction.z, direction.x) / (2.0 * PI) + 0.5,
                asin(clamp(direction.y, -1.0, 1.0)) / PI + 0.5);
}

vec3 CosineSampleHemisphere(vec2 xi, vec3 n) {
    float phi = 2.0 * PI * xi.x;
    float cosTheta = sqrt(1.0 - xi.y);
    float sinTheta = sqrt(xi.y);
    vec3 h = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
    vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, n));
    return normalize(tangent * h.x + cross(n, tangent) * h.y + n * h.z);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_Irradiance);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / u_OutputSize;
    vec3 n = DirectionFromEquirect(uv);
    vec3 irradianceOverPi = vec3(0.0);
    for (uint i = 0u; i < SAMPLE_COUNT; ++i) {
        vec3 l = CosineSampleHemisphere(Hammersley(i), n);
        irradianceOverPi += textureLod(u_EnvironmentSource, EquirectUV(l), 1.0).rgb;
    }
    imageStore(u_Irradiance, pixel, vec4(irradianceOverPi / float(SAMPLE_COUNT), 1.0));
}
