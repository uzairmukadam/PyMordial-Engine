#version 450 core
// ============================================================================
//  Radiance Cascade Merge (far -> near)
//
//  Merges a FAR cascade's directional intervals into a NEAR cascade's, one
//  probe and one direction per invocation.
//
//  Direction mapping: RCDirection is a nested equal-solid-angle hierarchy with
//  four children per parent, so near direction `d` owns exactly the far
//  children 4*d .. 4*d+3. All four children carry equal solid angle and are
//  combined with equal weight. See shaders/common/rc_direction.glsl.
//
//  Spatial mapping: the far probe grid is coarser, so a near probe maps to a
//  fractional far-probe coordinate and is bilinearly interpolated. Transparent
//  intervals (RGB = 0, A = 1) are valid data and participate normally.
//
//  Output: the near cascade's merged texture (RGB radiance, A transmittance).
// ============================================================================

#include "shaders/common/rc_composite.glsl"
#include "shaders/common/rc_direction.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) writeonly uniform image2DArray u_MergedOutput;
layout(binding = 1) uniform sampler2DArray u_NearIntervals;
layout(binding = 2) uniform sampler2DArray u_FarIntervals;

uniform ivec2 u_NearProbeSize;
uniform ivec2 u_FarProbeSize;
uniform int u_DirectionCount;
uniform int u_FarDirectionCount;
// Cascade isolation gate. 0 = do not admit this far cascade at all, so the
// near interval passes through unchanged. The CPU sets this per dispatch from
// the user-facing 0/1/2 setting (0 = C0 only, 1 = C1 into C0, 2 = full chain).
uniform int u_RCMergeMaxCascade;

void main() {
    ivec2 probe = ivec2(gl_GlobalInvocationID.xy);
    int direction = int(gl_GlobalInvocationID.z);

    if (probe.x >= u_NearProbeSize.x || probe.y >= u_NearProbeSize.y || direction >= u_DirectionCount) {
        return;
    }

    vec4 nearInterval = texelFetch(u_NearIntervals, ivec3(probe, direction), 0);

    // Angular mapping: RCDirection is a nested equal-solid-angle hierarchy with
    // FOUR children per parent, so near direction `direction` owns exactly the
    // far children 4*d .. 4*d+3. All four children have equal solid angle, so
    // they combine with equal weight.
    int child0 = direction * 4;
    int child1 = direction * 4 + 1;
    int child2 = direction * 4 + 2;
    int child3 = direction * 4 + 3;

    // Map the near probe centre into far-probe space.
    vec2 nearUV = (vec2(probe) + 0.5) / vec2(u_NearProbeSize);
    vec2 farCoord = nearUV * vec2(u_FarProbeSize) - 0.5;
    ivec2 farBase = ivec2(floor(farCoord));
    vec2 frac = farCoord - vec2(farBase);

    vec4 farSum = vec4(0.0);
    float weightSum = 0.0;

    for (int dy = 0; dy <= 1; ++dy) {
        for (int dx = 0; dx <= 1; ++dx) {
            ivec2 farProbe = clamp(farBase + ivec2(dx, dy), ivec2(0), u_FarProbeSize - 1);
            float w = (dx == 0 ? 1.0 - frac.x : frac.x) * (dy == 0 ? 1.0 - frac.y : frac.y);
            if (w <= 0.0) {
                continue;
            }
            vec4 interval0 = RCSanitizeInterval(
                texelFetch(u_FarIntervals, ivec3(farProbe, child0), 0)
            );
            vec4 interval1 = RCSanitizeInterval(
                texelFetch(u_FarIntervals, ivec3(farProbe, child1), 0)
            );
            vec4 interval2 = RCSanitizeInterval(
                texelFetch(u_FarIntervals, ivec3(farProbe, child2), 0)
            );
            vec4 interval3 = RCSanitizeInterval(
                texelFetch(u_FarIntervals, ivec3(farProbe, child3), 0)
            );
            vec4 farInterval = 0.25 * interval0 + 0.25 * interval1
                             + 0.25 * interval2 + 0.25 * interval3;
            farSum += farInterval * w;
            weightSum += w;
        }
    }

    vec4 farInterval = weightSum > 0.0 ? farSum / weightSum : vec4(0.0, 0.0, 0.0, 1.0);
    // Cascade isolation: when this far cascade is not admitted, the near
    // interval passes through unchanged instead of being composed with it.
    vec4 merged = u_RCMergeMaxCascade > 0 ? RCCompositeIntervals(nearInterval, farInterval) : nearInterval;

    imageStore(u_MergedOutput, ivec3(probe, direction), merged);
}
