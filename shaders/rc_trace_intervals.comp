#version 450 core
// ============================================================================
//  Radiance Cascade Interval Tracing
//
//  One invocation = one probe, one direction, one cascade.
//
//  Dispatch:
//      X, Y  -> probe grid coordinate (8x8 workgroups)
//      Z     -> direction index
//
//  Each invocation traces ONLY its cascade's distance interval
//  [u_IntervalStart, u_IntervalEnd] and stores the radiance found inside it.
//  Directions are never integrated here; that is the reconstruction stage.
//
//  Output (RGBA16F texture array, layer = direction):
//      RGB = radiance accumulated inside the interval
//      A   = remaining transmittance through the interval (1 = fully open)
// ============================================================================

#include "shaders/common/depth.glsl"
#include "shaders/common/hiz_bounds.glsl"
#include "shaders/common/rc_direction.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) writeonly uniform image2DArray u_IntervalOutput;

layout(binding = 1) uniform sampler2D u_GBufferDepth;
layout(binding = 2) uniform sampler2D u_GBufferNormalMetallic;
layout(binding = 3) uniform sampler2D u_DirectRadiance;
layout(binding = 4) uniform sampler2D u_HiZBoundsTexture;   // RG32F linear-depth bounds
layout(binding = 5) uniform sampler2D u_GBufferSurfaceID;   // R32F stable object identity

layout(std140, binding = 0) uniform FrameData {
    mat4 u_View;
    mat4 u_Projection;
    mat4 u_ViewProjection;
    mat4 u_InvProjection;
    mat4 u_InvView;

    vec4 u_CameraPos_Time;
    vec4 u_ScreenSize_Jitter;

    vec4 u_SunDirection_Intensity;
    vec4 u_SunColor_Ambient;

    mat4 u_LightViewProjection[4];
    vec4 u_CascadeSplits;

    vec4 u_FogColor_Density;
    vec4 u_FogParams;
};

uniform vec2 u_TargetResolution;
uniform int u_ProbeWidth;
uniform int u_ProbeHeight;
uniform int u_DirectionCount;
uniform float u_IntervalStart;
uniform float u_IntervalEnd;
// Far end of the whole RC system (not this cascade's interval end). Used for a
// single global distance-confidence falloff so the term stays continuous across
// cascade boundaries.
uniform float u_GlobalMaxDistance;
uniform float u_Thickness;
uniform int u_MaxIterations;
uniform float u_Intensity;

#include "shaders/common/hiz_trace.glsl"

vec3 OctahedralDecode(vec2 f) {
    f = f * 2.0 - 1.0;
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

void main() {
    ivec2 probe = ivec2(gl_GlobalInvocationID.xy);
    int direction = int(gl_GlobalInvocationID.z);

    if (probe.x >= u_ProbeWidth || probe.y >= u_ProbeHeight || direction >= u_DirectionCount) {
        return;
    }

    // Probe centre in screen UV.
    vec2 uv = (vec2(probe) + 0.5) / vec2(float(u_ProbeWidth), float(u_ProbeHeight));

    // Empty / background probe: no receiver surface, so the interval is fully
    // open and carries no radiance.
    float raw_depth = texture(u_GBufferDepth, uv).r;
    if (IsBackgroundDepth(raw_depth)) {
        imageStore(u_IntervalOutput, ivec3(probe, direction), vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec3 view_pos = ReconstructViewPosition(uv, raw_depth, u_InvProjection);
    if (!(abs(view_pos.z) > 1e-5)) {
        // Invalid receiver (degenerate projection).
        imageStore(u_IntervalOutput, ivec3(probe, direction), vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec3 normal_world = OctahedralDecode(texture(u_GBufferNormalMetallic, uv).rg);
    vec3 normal_view = normalize(mat3(u_View) * normal_world);
    float originSurfaceID = texture(u_GBufferSurfaceID, uv).r;

    vec3 ray_dir = RCDirection(direction, u_DirectionCount);

    // Conservative origin offset so the probe does not immediately hit itself.
    vec3 ray_origin = view_pos + normal_view * max(0.02, abs(view_pos.z) * 0.0005);

    HiZTraceRequest request;
    request.originView = ray_origin;
    request.directionView = ray_dir;
    // Start beyond the thickness slab so the receiver's own surface cannot be
    // accepted as an immediate hit.
    request.minDistance = max(u_IntervalStart, 0.02);
    request.maxDistance = max(u_IntervalEnd, request.minDistance + 1e-3);
    request.thickness = u_Thickness;
    request.startMip = 0;
    request.maxIterations = u_MaxIterations;

    vec3 radiance = vec3(0.0);
    float transmittance = 1.0;

    // A rejected hit (backface or the probe's own surface) must not end the
    // trace: at close range the receiver's own surface fills the view, so the
    // first Hi-Z hit is almost always a self-hit. Restarting the trace just
    // past that hit lets the ray reach the geometry behind it instead of
    // returning black, which is what made close-up GI vanish.
    float traceStart = request.minDistance;
    for (int attempt = 0; attempt < 4; ++attempt) {
        request.minDistance = traceStart;
        HiZTraceHit hit = TraceHiZ(u_HiZBoundsTexture, u_GBufferDepth, request);
        if (!hit.hit) {
            break;
        }

        // Backface rejection: a surface facing away from the probe cannot
        // contribute reflected radiance towards it.
        vec3 hit_normal_world = OctahedralDecode(texture(u_GBufferNormalMetallic, hit.uv).rg);
        vec3 hit_normal_view = normalize(mat3(u_View) * hit_normal_world);
        bool facing = dot(hit_normal_view, -ray_dir) > 0.05;

        // Same-surface rejection: a hit on the probe's own surface is a
        // self-intersection, not a bounce. Mirrors the legacy marcher's
        // surface-ID + normal + tangent-distance test.
        float hitSurfaceID = texture(u_GBufferSurfaceID, hit.uv).r;
        vec3 hit_position_view = ReconstructViewPosition(hit.uv, hit.rawDepth, u_InvProjection);
        float tangentDistance = abs(dot(normal_view, hit_position_view - view_pos));
        bool sameSurface = originSurfaceID > 0.0
            && abs(hitSurfaceID - originSurfaceID) < 0.25
            && dot(normal_view, hit_normal_view) > 0.96
            && tangentDistance < max(0.03, hit.rayDistance * 0.02);

        if (!facing || sameSurface) {
            // Skip past this rejected surface and keep tracing.
            traceStart = hit.rayDistance + max(u_Thickness * 2.0, hit.rayDistance * 0.01);
            if (traceStart >= request.maxDistance) {
                break;
            }
            continue;
        }

        vec3 hit_radiance = texture(u_DirectRadiance, hit.uv).rgb;
        if (any(isnan(hit_radiance)) || any(isinf(hit_radiance))) {
            hit_radiance = vec3(0.0);
        }

        // Screen-edge confidence: a hit near the border is less reliable
        // because the ray may have left the screen just beyond it.
        vec2 edge = smoothstep(0.0, 0.08, hit.uv) * (1.0 - smoothstep(0.92, 1.0, hit.uv));
        float edge_fade = edge.x * edge.y;

        // Global distance confidence: one continuous falloff over the whole
        // RC range, so it never resets at a cascade boundary.
        float distanceConfidence = clamp(
            1.0 - hit.rayDistance / max(u_GlobalMaxDistance, 1e-3),
            0.0,
            1.0
        );

        radiance = hit_radiance * edge_fade * distanceConfidence * u_Intensity;
        // Opaque deferred geometry: an accepted hit terminates the interval.
        // Transmittance must not depend on screen position, so edge_fade
        // stays on radiance only.
        transmittance = 0.0;
        break;
    }

    if (any(isnan(radiance)) || any(isinf(radiance))) {
        radiance = vec3(0.0);
    }
    if (isnan(transmittance) || isinf(transmittance)) {
        transmittance = 1.0;
    }

    imageStore(
        u_IntervalOutput,
        ivec3(probe, direction),
        vec4(clamp(radiance, vec3(0.0), vec3(1e4)), clamp(transmittance, 0.0, 1.0))
    );
}
